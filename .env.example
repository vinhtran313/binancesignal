# Database
DATABASE_URL="postgresql://trader:traderpass@localhost:5432/trading_terminal?schema=public"

# Application
NEXT_PUBLIC_APP_NAME="Futures Trading Terminal"
NODE_ENV="development"

# Comma-separated Binance USDT perpetuals to monitor (default: curated watchlist in the app)
WATCHLIST_SYMBOLS="BTC,ETH,BNB,XRP,SOL,HYPE,ZEC,DOGE,XMR,LINK,LEO,NEAR,XLM,BCH,UNI,AVAX,SUI,CC,GRAM,TAO,ENA,OKB,FET,ONDO,DOT,PUMP,ASTER"

# Telegram signal alerts (optional; send actionable signals only)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Trading Configuration
DEFAULT_LEVERAGE=125
DEFAULT_RISK_PERCENT=1
MAX_CONCURRENT_POSITIONS=10
INITIAL_BALANCE=500

# Fee Configuration (per side, as decimal)
DEFAULT_TAKER_FEE=0.001
DEFAULT_MAKER_FEE=0.001

# Slippage (as decimal)
DEFAULT_SLIPPAGE=0.0005
